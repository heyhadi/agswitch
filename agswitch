#!/bin/bash
# agswitch: switch the Google account used by Antigravity / agy.
# The login lives in the Keychain item "gemini". Saved (inactive) accounts are kept only in the
# Keychain as "agswitch:<name>" (never in files) and are deleted after AGSWITCH_DAYS days.
# Expiry only removes the local copy; it does NOT revoke the token at Google.
set -euo pipefail

SVC="${AGSWITCH_SVC:-gemini}"
DIR="${AGSWITCH_DIR:-$HOME/.agswitch}"
ACCOUNTS_JSON="${AGSWITCH_ACCOUNTS_JSON:-$HOME/.gemini/google_accounts.json}"
DAYS="${AGSWITCH_DAYS:-30}"
APPS=(-T /Applications/Antigravity.app -T /Applications/Antigravity.app/Contents/Resources/bin/language_server -T "$HOME/.local/bin/agy" -T /usr/bin/security)

die() { echo "agswitch: $*" >&2; exit 1; }
mkdir -p "$DIR" && chmod 700 "$DIR"

# Write a secret via stdin of `security -i`, so it never appears in the process list.
kc_put() { # service account secret
  local esc; esc=$(printf '%s' "$3" | sed 's/\\/\\\\/g; s/"/\\"/g')
  security delete-generic-password -s "$1" >/dev/null 2>&1 || true
  local t args=""; for t in "${APPS[@]}"; do args+=" \"$t\""; done
  [ "${AGSWITCH_TEST:-}" = 1 ] && args=""
  printf 'add-generic-password -s "%s" -a "%s"%s -w "%s"\n' "$1" "$2" "$args" "$esc" | security -i >/dev/null
  [ "$(security find-generic-password -s "$1" -w)" = "$3" ] || die "Keychain verification failed for $1"
}
kc_acct() { security find-generic-password -s "$1" 2>/dev/null | sed -n 's/.*"acct"<blob>="\(.*\)"$/\1/p'; }

valid_name() { [[ "$1" =~ ^[a-zA-Z0-9_-]+$ ]] || die "account name may only contain letters, digits, - and _"; }

ensure_closed() {
  [ "${AGSWITCH_TEST:-}" = 1 ] && return
  if pgrep -f "Antigravity.app/Contents/MacOS/Antigravity|Contents/Resources/bin/language_server|\.local/bin/agy" >/dev/null; then
    die "Antigravity/agy is still running. Quit it (Cmd+Q) and try again."
  fi
}

expire() {
  local f name age
  for f in "$DIR"/*.saved; do
    [ -e "$f" ] || continue
    name=$(basename "$f" .saved)
    age=$(( ( $(date +%s) - $(stat -f %m "$f") ) / 86400 ))
    if [ "$age" -ge "$DAYS" ]; then
      security delete-generic-password -s "agswitch:$name" >/dev/null 2>&1 || true
      rm -f "$f" "$DIR/$name.accounts.json"
      echo "Account '$name' expired (${age} days) and was removed. Sign in again to use it."
    fi
  done
}

current() { cat "$DIR/current" 2>/dev/null || true; }

# Move the active login into storage under <name>.
stash() {
  local name=$1 secret acct
  secret=$(security find-generic-password -s "$SVC" -w 2>/dev/null) || die "no active login in the Keychain ($SVC)"
  acct=$(kc_acct "$SVC")
  [ -n "$acct" ] || die "could not read the Keychain account attribute"
  kc_put "agswitch:$name" "$acct" "$secret"
  [ -f "$ACCOUNTS_JSON" ] && install -m 600 "$ACCOUNTS_JSON" "$DIR/$name.accounts.json"
  touch "$DIR/$name.saved"
}

cmd=${1:-list}
expire
case "$cmd" in
  list)
    cur=$(current); echo "Active: ${cur:-(unnamed, run: agswitch name <name>)}"
    for f in "$DIR"/*.saved; do
      [ -e "$f" ] || continue
      n=$(basename "$f" .saved); age=$(( ( $(date +%s) - $(stat -f %m "$f") ) / 86400 ))
      echo "Saved: $n (expires in $(( DAYS - age )) days)"
    done ;;
  name) # name the account that is logged in right now
    valid_name "${2:-}"; echo "$2" > "$DIR/current"; echo "Active login named '$2'." ;;
  use)
    target=${2:-}; valid_name "$target"; ensure_closed
    cur=$(current)
    [ -n "$cur" ] || die "name the active login first: agswitch name <name>"
    [ "$cur" = "$target" ] && { echo "'$target' is already active."; exit 0; }
    [ -f "$DIR/$target.saved" ] || die "account '$target' is not saved or has expired"
    secret=$(security find-generic-password -s "agswitch:$target" -w)
    acct=$(kc_acct "agswitch:$target")
    stash "$cur"
    kc_put "$SVC" "$acct" "$secret"
    [ -f "$DIR/$target.accounts.json" ] && install -m 600 "$DIR/$target.accounts.json" "$ACCOUNTS_JSON"
    # Only one copy per account: the active one lives in "$SVC" alone.
    security delete-generic-password -s "agswitch:$target" >/dev/null 2>&1
    rm -f "$DIR/$target.saved" "$DIR/$target.accounts.json"
    echo "$target" > "$DIR/current"
    echo "Switched to '$target'. '$cur' saved for ${DAYS} days. Open Antigravity again." ;;
  new) # stash the current account so you can log in with another one
    ensure_closed; cur=$(current)
    [ -n "$cur" ] || die "name the active login first: agswitch name <name>"
    stash "$cur"
    security delete-generic-password -s "$SVC" >/dev/null 2>&1
    rm -f "$DIR/current"
    echo "'$cur' saved. Open Antigravity, sign in with another account, then: agswitch name <name>" ;;
  forget)
    valid_name "${2:-}"; security delete-generic-password -s "agswitch:$2" >/dev/null 2>&1 || true
    rm -f "$DIR/$2.saved" "$DIR/$2.accounts.json"; echo "'$2' removed." ;;
  *) echo "Usage: agswitch [list | name <name> | new | use <name> | forget <name>]"; exit 1 ;;
esac
